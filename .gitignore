# ==============================================================================
# Credit Risk Scorecard — .gitignore
# ==============================================================================

# ── Python ────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
*.egg
dist/
build/
*.whl

# ── Virtual environments ─────────────────────────────────────
.venv/
venv/
env/
.env

# ── IDE / Editor ─────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.project
.settings/

# ── OS files ─────────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini

# ── Jupyter ──────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb_checkpoints

# ── Model artefacts (optional — uncomment to track) ──────────
# pd_model.pkl
# pd_model_final.pkl

# ── Data (large files — do not commit) ───────────────────────
# cs-training.csv

# ── Logs ─────────────────────────────────────────────────────
*.log
logs/
